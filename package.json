{
  "name": "agent-harness",
  "version": "1.0.0",
  "private": true,
  "description": "Arnés de agente portable: hooks, gate, subagentes, comandos y docs para replicar buenas prácticas en cualquier repo.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "gate": "node scripts/gate.mjs",
    "gate:fast": "node scripts/gate.mjs fast",
    "lint": "node scripts/repo-lint.mjs",
    "lint:rules": "node scripts/repo-lint.mjs --rules",
    "selftest": "node scripts/harness-selftest.mjs",
    "linkcheck": "node scripts/docs-linkcheck.mjs",
    "hooks:install": "node scripts/hooks-install.mjs",
    "harness:install": "node scripts/harness-init.mjs",
    "ciclo": "node scripts/ciclo-check.mjs --rules",
    "timing": "node scripts/hooks-timing.mjs",
    "timing:rules": "node scripts/hooks-timing.mjs --rules"
  }
}
